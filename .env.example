# Autenticação da interface Agent Zero (obrigatório)
AUTH_LOGIN=admin
AUTH_PASSWORD=troque-esta-senha
ROOT_PASSWORD=troque-esta-senha-root
RFC_PASSWORD=troque-esta-senha-rfc

# Integrações opcionais. O padrão não exige API externa: ChatGPT Browser faz
# chat, compactação/Utility e reparo. Para usar Kimi/We64, veja README.md e
# habilite o profile `kimi`; nunca grave a chave no Git.
COMPOSE_PROFILES=browser-utility,browser-repair
API_KEY_OTHER=not-used-with-browser-backend
KIMI_UPSTREAM_URL=https://api.we64.com/v1
DEFAULT_MODEL=chatgpt-browser
DEFAULT_API_BASE=http://chatgpt-browser-agent:8000/v1
DEFAULT_CONTEXT_LENGTH=131072
UTILITY_MODEL=chatgpt-browser-utility
UTILITY_API_BASE=http://chatgpt-browser-utility:8000/v1
UTILITY_CONTEXT_LENGTH=131072
REPAIR_MODEL=chatgpt-browser
REPAIR_API_BASE=http://chatgpt-browser-repair:8000/v1
REPAIR_CONTEXT_LENGTH=131072
REPAIR_REQUIRES_BROWSER=true

# VNC aceita no máximo 8 caracteres. Use apenas letras, números, _ e -.
VNC_PASSWORD=Vnc12345

# Token compartilhado entre o plugin e o executor do VS Code.
VSCODE_EXEC_TOKEN=gere-um-token-aleatorio-longo
BROWSER_POOL_NOTICE_TOKEN=gere-um-token-de-aviso-aleatorio-longo
REPAIR_AGENT_API_TOKEN=gere-um-token-de-reparo-aleatorio-longo
MAIN_AGENT_API_TOKEN=gere-um-token-api-principal-aleatorio-longo

# WhatsApp/Meta AI é opcional. Para ativar, acrescente `whatsapp` a
# COMPOSE_PROFILES e informe o telefone com DDI, somente dígitos.
WA_PHONE=
WHATSAPP_JOURNAL_GROUP_NAME=jornal-diario
WHATSAPP_JOURNAL_TOKEN=gere-outro-token-aleatorio-longo

# Rede, portas e localização
TZ=America/Sao_Paulo
PUBLIC_HOST=localhost
PUBLIC_BASE_URL=http://localhost:50080/
AGENT_ZERO_PORT=50080
AGENT_ZERO_SSH_PORT=50022
CHATGPT_VNC_PORT=50081
CHATGPT_VNC_2_PORT=50083
CHATGPT_VNC_3_PORT=50085
CHATGPT_UTILITY_VNC_PORT=50084
CHATGPT_REPAIR_VNC_PORT=50087
CHATGPT_REPAIR_UTILITY_VNC_PORT=50088
AGENT_ZERO_REPAIR_PORT=50086
VSCODE_PORT=50082

# Dados persistentes. Caminho relativo ou absoluto no host Linux.
STACK_DATA_DIR=./data

# A montagem abaixo concede acesso integral ao host. Leia SECURITY.md.
HOST_ROOT_MOUNT=/
VAULT_PATH=./data/vault

# Nome local da imagem customizada, construída sobre Agent Zero v2.12.
AGENT_ZERO_IMAGE=agent-zero-browser-stack-agent-zero:v2.12
# Versão das migrações de estado persistente. Não reduza em atualizações.
STACK_SCHEMA_VERSION=v2.12-stack.14
