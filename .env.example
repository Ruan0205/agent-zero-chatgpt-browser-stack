# Autenticação da interface Agent Zero (obrigatório)
AUTH_LOGIN=admin
AUTH_PASSWORD=troque-esta-senha
ROOT_PASSWORD=troque-esta-senha-root
RFC_PASSWORD=troque-esta-senha-rfc

# Provedor Featherless usado pelos presets Default e Efficiency
API_KEY_OTHER=cole-a-chave-da-featherless
DEFAULT_MODEL=Blackfrost-AI/Qwen3.8-27B-ABLITERATED-BF16
UTILITY_MODEL=google/gemma-4-E2B-it

# VNC aceita no máximo 8 caracteres. Use apenas letras, números, _ e -.
VNC_PASSWORD=Vnc12345

# Token compartilhado entre o plugin e o executor do VS Code.
VSCODE_EXEC_TOKEN=gere-um-token-aleatorio-longo
BROWSER_POOL_NOTICE_TOKEN=gere-um-token-de-aviso-aleatorio-longo

# WhatsApp/Meta AI. Informe o telefone com DDI, somente dígitos.
# A sessão NÃO vem no repositório; o pareamento é feito após subir a stack.
WA_PHONE=5511999999999
WHATSAPP_JOURNAL_GROUP_NAME=jornal-diario
WHATSAPP_JOURNAL_TOKEN=gere-outro-token-aleatorio-longo

# Rede, portas e localização
TZ=America/Sao_Paulo
PUBLIC_HOST=localhost
PUBLIC_BASE_URL=http://localhost:50080/
AGENT_ZERO_PORT=50080
AGENT_ZERO_SSH_PORT=50022
CHATGPT_VNC_PORT=50081
VSCODE_PORT=50082

# Dados persistentes. Caminho relativo ou absoluto no host Linux.
STACK_DATA_DIR=./data

# A montagem abaixo concede acesso integral ao host. Leia SECURITY.md.
HOST_ROOT_MOUNT=/
VAULT_PATH=./data/vault

# Nome local da imagem customizada, construída sobre Agent Zero v2.12.
AGENT_ZERO_IMAGE=agent-zero-browser-stack-agent-zero:v2.12
